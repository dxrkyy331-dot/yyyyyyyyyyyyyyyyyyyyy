{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Rockstar Client",
	"description": "Klient Fabric dla Minecraft 1.21.4 z ClickGUI (Prawy Shift), HUD i modulami wizualnymi.",
	"authors": [
		"TWOJ_NICK"
	],
	"contact": {
		"homepage": "https://github.com/TWOJ_NICK/rockstar-client",
		"sources": "https://github.com/TWOJ_NICK/rockstar-client"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}